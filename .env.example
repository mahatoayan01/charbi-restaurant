# ==============================================================================
# CHARBI RESTAURANT - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# Copy this file to .env or .env.local to configure production credentials.
# If none of these variables are set, the application operates in DEMO MODE
# with local browser storage and seeded sample data.
# ==============================================================================

# Demo Mode Owner Credentials (Used only when Firebase is not configured)
# Change these in your local .env or configure Firebase Auth for production
VITE_DEMO_ADMIN_EMAIL=admin@charbirestaurant.com
VITE_DEMO_ADMIN_PASSWORD=password123

# Firebase Production Backend (Auth + Cloud Firestore)
# Create a Firebase project at https://console.firebase.google.com
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Razorpay Payment Gateway (Test / Production Key ID)
# Obtain your key from https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Optional Instagram Basic Display API Access Token
# If left blank, uses the curated gallery from src/config/restaurant.js
VITE_INSTAGRAM_TOKEN=your_instagram_user_access_token_here
