rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated() && (
        request.auth.token.email == "owner@charbirestaurant.com" ||
        request.auth.token.admin == true
      );
    }

    // Orders Collection
    // - Customers can create new orders
    // - Only logged-in owner can read, update status, or delete orders
    match /orders/{orderId} {
      allow create: if request.resource.data.total is number 
                    && request.resource.data.customerPhone is string;
      allow read, update, delete: if isAuthenticated();
    }

    // Payments Collection
    // - Created upon payment attempt
    // - Only authenticated owner can read financial logs
    match /payments/{paymentId} {
      allow create: if request.resource.data.amount is number;
      allow read, update, delete: if isAuthenticated();
    }

    // Table Reservations & Inquiries
    // - Customers can submit reservations
    // - Only owner can read, confirm, or delete reservations
    match /reservations/{reservationId} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.phone is string;
      allow read, update, delete: if isAuthenticated();
    }

    // Menu Items Collection
    // - Public read access for customers
    // - Write/edit access restricted to authenticated owner
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}

